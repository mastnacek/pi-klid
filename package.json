{
  "name": "pi-klid",
  "version": "1.0.0",
  "description": "Quiet zen mode for the pi coding agent. /klid hides thinking and tool activity behind a static \"Working...\" cover, a live SPAI task list, or the SPAI kanban board until the agent settles.",
  "type": "module",
  "license": "MIT",
  "author": "jara",
  "keywords": [
    "pi-package",
    "pi",
    "klid",
    "quiet",
    "zen",
    "focus",
    "minimal",
    "breathing",
    "distraction-free"
  ],
  "files": [
    "README.md",
    "index.ts",
    "kanban.ts",
    "palette.ts",
    "spai-board.ts",
    "spai.ts",
    "package.json"
  ],
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*"
  },
  "devDependencies": {
    "@types/node": "^26.4.0",
    "typescript": "^7.0.2"
  }
}